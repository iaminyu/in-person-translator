# Required. Google AI Studio key with access to the Gemini Live API.
GEMINI_API_KEY=

# Optional, recommended. Without it there is no second engine when Gemini
# fails, a translation that comes without a voice is not read aloud, and
# text that Gemini leaves out is not filled in.
OPENAI_API_KEY=

# Set this before the server is reachable by anyone but you. People are asked
# for it once per browser. Without it, whoever finds the address spends your
# API quota.
ACCESS_CODE=

# Set to 1 when the server sits behind one tunnel or reverse proxy, so the
# per-visitor brakes count visitors and not the proxy. Leave empty otherwise.
TRUST_PROXY=

# Set to 1 to leave out the line at the foot of the page that links to the
# hosted version and to the source. You are welcome to.
HIDE_CREDIT=

# Models. The defaults are the ones the decision records were measured on.
GEMINI_LIVE_MODEL=gemini-3.8-live
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

PORT=3901
HOST=127.0.0.1
